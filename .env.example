# OpenAI
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini

# Banco de dados (SQLite para dev / PostgreSQL para produção)
DATABASE_URL=clinica_bot.sqlite

# Meta WhatsApp Cloud API
# Obtenha em: https://developers.facebook.com/apps/ > WhatsApp > API Setup
META_ACCESS_TOKEN=seu-access-token-permanente
META_PHONE_NUMBER_ID=seu-phone-number-id
META_WEBHOOK_VERIFY_TOKEN=um-token-secreto-qualquer
META_APP_SECRET=app-secret-do-seu-app-meta
META_API_VERSION=v20.0
